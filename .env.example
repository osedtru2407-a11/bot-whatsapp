# ============================================================================
# CONFIGURACIÓN DE BASE DE DATOS (PostgreSQL)
# ============================================================================
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=tu_contrasena_de_postgres
PG_DATABASE=whatsapp_sales_bot
# TYPEORM_SYNC=true # Habilitar temporalmente para sincronizar tablas y columnas en desarrollo

# ============================================================================
# SEGURIDAD Y ADMINISTRADOR INICIAL DEL SISTEMA
# ============================================================================
# Si la base de datos es nueva y no tiene usuarios, el sistema puede inicializar
# el primer usuario Administrador con estos datos.
# Si no defines INITIAL_ADMIN_PASSWORD, el sistema generará una contraseña aleatoria
# segura al arrancar y la mostrará en la consola una sola vez obligando a cambiarla.
INITIAL_ADMIN_EMAIL=admin@tuempresa.com
INITIAL_ADMIN_PASSWORD=TuPasswordSuperSeguro123!*
INITIAL_ADMIN_NAME=Administrador Inicial

# ============================================================================
# CONFIGURACIÓN DE CORREO SALIENTE (SMTP) - RECUPERACIÓN DE CONTRASEÑA
# ============================================================================
# Configura las credenciales de tu proveedor de correo (Gmail, Outlook, Hostinger, etc.)
# Para Gmail, usa una "Contraseña de aplicación" generada en tu cuenta de Google.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tu_correo@gmail.com
SMTP_PASS=tu_contrasena_de_aplicacion
SMTP_FROM="WhatsApp Sales Bot Studio <no-reply@tuempresa.com>"
# URL base donde corre el frontend para generar el enlace del correo:
APP_URL=http://localhost:3000

# ============================================================================
# INTEGRACIONES
# ============================================================================
# JWT_SECRET=tu_clave_secreta_para_tokens_jwt
# WWEBJS_TEST_REMOTE_ID=XXXXXXXXXX@c.us
# WWEBJS_TEST_CLIENT_ID=authenticated
