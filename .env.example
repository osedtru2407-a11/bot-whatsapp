# ============================================================================
# CONFIGURACIÓN DE BASE DE DATOS (PostgreSQL)
# ============================================================================
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=tu_contrasena_de_postgres
PG_DATABASE=whatsapp_sales_bot

# ============================================================================
# SEGURIDAD Y ADMINISTRADOR INICIAL DEL SISTEMA
# ============================================================================
# Si la base de datos es nueva y no tiene usuarios, el sistema puede inicializar
# el primer usuario Administrador con estos datos.
# Si no defines INITIAL_ADMIN_PASSWORD, el sistema generará una contraseña aleatoria
# segura al arrancar y la mostrará en la consola una sola vez obligando a cambiarla.
INITIAL_ADMIN_EMAIL=admin@tuempresa.com
INITIAL_ADMIN_PASSWORD=TuPasswordSuperSeguro123!*
INITIAL_ADMIN_NAME=Administrador Inicial

